# Copy to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.

# --- Supabase (Settings → API / JWT Keys) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret (JWT Keys → Legacy JWT Secret). Signs our user / phone tokens.
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sarvam AI: speech-to-text (dashboard.sarvam.ai → API keys) ---
SARVAM_API_KEY=
# Optional: saaras:v3 supports output modes, saaras:v4 supports keyterms
SARVAM_STT_MODEL=saaras:v3
# codemix = English words in English letters, Tamil words in Tamil script, numbers as digits
SARVAM_STT_MODE=codemix
# ta-IN, en-IN, … or `unknown` to auto-detect
SARVAM_STT_LANGUAGE=ta-IN

# --- OpenAI: Form Analyzer + Field Mapping agents (platform.openai.com → API keys) ---
OPENAI_API_KEY=
# Every AI step uses gpt-5.4-mini@low unless set here (see docs/ai-model-plan.md). Optional override
# for all steps, and per step. A reasoning effort can follow @, e.g. gpt-5.4-mini@none;
# AGENT_REASONING sets it for all reasoning (GPT-5 / o-series) models.
# AGENT_MODEL=
# MAPPER_MODEL=
# ANALYZER_MODEL=
# RESOLVER_MODEL=
# AGENT_REASONING=

# Public HTTPS origin the phone opens from the QR code (your Vercel URL)
PUBLIC_BASE_URL=https://YOUR-APP.vercel.app

# Daily clean-up of uploaded files from abandoned sessions (Vercel Cron sends it as a Bearer token).
# Any long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
