# Copy to .env.local
VITE_API_BASE=http://localhost:3000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Where people get an account, upgrade from the Trial or renew their plan, linked from the popup: a page
# on your site or a WhatsApp chat link (https://wa.me/91XXXXXXXXXX?text=...).
# Defaults to https://www.alphainfotech.org/voice2fill.
VITE_ACCOUNT_URL=https://www.alphainfotech.org/voice2fill
# Privacy policy page linked from the sign-in card (required for the Chrome Web Store).
# Defaults to $VITE_API_BASE/privacy.
VITE_PRIVACY_URL=https://YOUR-SITE/privacy
