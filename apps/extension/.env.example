# Copy to .env.local
VITE_API_BASE=http://localhost:3000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Where people get an account or renew their plan, linked from the popup: a WhatsApp chat link
# (https://wa.me/91XXXXXXXXXX?text=...) or a page on your site. Leave empty to hide the links.
VITE_ACCOUNT_URL=
# Privacy policy page linked from the sign-in card (required for the Chrome Web Store).
# Defaults to $VITE_API_BASE/privacy.
VITE_PRIVACY_URL=https://YOUR-SITE/privacy
